# ⚠️ ARCHIVO DE EJEMPLO - NO USAR EN PRODUCCIÓN
# Contactar al administrador para obtener archivo .env con credenciales

# URI de conexión a MongoDB (proporcionar por administrador)
MONGO_URI=mongodb+srv://[usuario]:[contraseña]@[host]/[database]

# URI de respaldo de MongoDB (proporcionar por administrador)
MONGO_URI_FALLBACK=mongodb://[usuario]:[contraseña]@[host]:27017/[database]

# Puerto del servidor
PORT=3005

# Ambiente
NODE_ENV=development
